# Copy to .env for local testing with `npm run dev`.
# For scheduled runs, set these in the Trigger.dev dashboard instead:
#   your project -> Settings -> Environment Variables -> Production

# ---------------------------------------------------------------------------
# SOURCES — read-only users only. The sync never writes to a source.
# ---------------------------------------------------------------------------

# Source 1: legacy MySQL (ask Marcus)
LEGACY_DATABASE_URL=mysql://user:password@host:3306/database

# Source 2: YZ. Optional — leave it unset and the sync just skips this source,
# the legacy sync carries on as normal.
#
# Set `dialect` for this source in sources.ts to match ("mysql" or "postgres").
# If YZ is Supabase/Postgres, use the SESSION POOLER string here too.
YZ_DATABASE_URL=mysql://user:password@host:3306/database

# ---------------------------------------------------------------------------
# DESTINATION
# ---------------------------------------------------------------------------

# Your own Postgres / Supabase.
# On Supabase use the SESSION POOLER string (Connect -> Session pooler),
# not "Direct connection" — direct is IPv6-only and won't resolve from
# Trigger.dev's workers.
YENES_DATABASE_URL=postgresql://postgres.abcdefgh:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
